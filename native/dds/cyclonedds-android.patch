   }
   //GVTRACE(" allow_loopback=%d\n", allow_loopback);
 
+  // Mobile ROS patch: if any advertised unicast address is directly reachable (same subnet as one of our
+  // interfaces), ignore the "distant" ones. Hosts often advertise addresses that cannot be reached from
+  // here (WSL mirrored 10.255.255.254, docker bridges, VPNs); picking one of those first silently breaks
+  // SEDP even though a perfectly good address is in the same list.
+  bool any_nearby = false;
+  for (struct nn_locators_one *l = uc->first; l != NULL && !any_nearby; l = l->next)
+  {
+    if (!allow_loopback && ddsi_is_loopbackaddr (gv, &l->loc))
+      continue;
+    any_nearby = (ddsi_is_nearby_address (gv, &l->loc, (size_t) gv->n_interfaces, gv->interfaces, NULL) == DNAR_LOCAL);
+  }
+
   bool direct = false;
   for (struct nn_locators_one *l = uc->first; l != NULL; l = l->next)
   {
+    if (any_nearby && !ddsi_is_loopbackaddr (gv, &l->loc) &&
+        ddsi_is_nearby_address (gv, &l->loc, (size_t) gv->n_interfaces, gv->interfaces, NULL) == DNAR_DISTANT)
