<?xml version="1.0"?>
<!-- Fixed third-person camera for ros2_jazzy_sim.sh (Gazebo Harmonic): renders the robot's start area on
     the Gazebo topic /demo_camera/image_raw, which the script bridges to ROS. The Classic version is
     sim_camera.sdf. -->
<sdf version="1.9">
  <model name="demo_camera">
    <static>true</static>
    <link name="link">
      <sensor name="demo_camera" type="camera">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <topic>/demo_camera/image_raw</topic>
        <camera>
          <horizontal_fov>1.3</horizontal_fov>
          <image><width>640</width><height>360</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>30</far></clip>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>
